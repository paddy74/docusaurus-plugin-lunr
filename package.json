{
  "name": "docusaurus-plugin-lunr",
  "version": "4.0.0",
  "description": "Offline search component for Docusaurus v3.9.2+",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./lunr.client": "./src/lunr.client.js",
    "./src/theme/SearchBar": "./src/theme/SearchBar/index.jsx"
  },
  "files": [
    "src/*.js",
    "src/theme",
    "README.md",
    "LICENSE-GPL3",
    "LICENSE-MIT"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "pnpm pack --dry-run",
    "test": "mocha 'src/__tests__/**/*.spec.js'",
    "format": "pnpm exec prettier . --write --config ../.prettierrc --ignore-path ../.prettierignore",
    "update-deps": "pnpm self-update && pnpm update --latest --recursive && pnpm audit --fix && pnpm install && pnpm dedupe",
    "clean-install": "pnpm store prune && rm -rf node_modules pnpm-lock.yaml && pnpm install"
  },
  "homepage": "https://github.com/paddy74/docusaurus-plugin-lunr/blob/latest/README.md",
  "repository": {
    "url": "https://github.com/paddy74/docusaurus-plugin-lunr/"
  },
  "author": {
    "name": "Praveen N",
    "url": "https://github.com/lelouch77"
  },
  "contributors": [
    {
      "name": "Pieter C",
      "url": "https://github.com/pcallewaert"
    },
    {
      "name": "ZachJW34",
      "url": "https://github.com/ZachJW34"
    },
    {
      "name": "Andrei Rublev",
      "url": "https://github.com/anru"
    },
    {
      "name": "Ris Adams",
      "url": "https://github.com/risadams"
    },
    {
      "name": "Patrick Young",
      "url": "https://github.com/paddy74"
    }
  ],
  "keywords": [
    "docusaurus",
    "lunr",
    "offline-search",
    "documentation"
  ],
  "license": "GPL3",
  "dependencies": {
    "autocomplete.js": "^0.38.1",
    "clsx": "^2.1.1",
    "gauge": "^5.0.2",
    "hast-util-select": "^6.0.4",
    "hast-util-to-text": "^4.0.2",
    "hogan.js": "^3.0.2",
    "lunr": "^2.3.9",
    "lunr-languages": "^1.19.0",
    "mark.js": "^8.11.1",
    "minimatch": "^10.2.5",
    "rehype-parse": "^9.0.1",
    "to-vfile": "^8.0.0",
    "unified": "^11.0.5",
    "unist-util-is": "^6.0.1"
  },
  "devDependencies": {
    "@j178/prek": "^0.3.13",
    "mocha": "^11.7.5",
    "prettier": "^3.8.3"
  },
  "peerDependencies": {
    "@docusaurus/core": "^3.9.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">= 22.0.0"
  }
}
